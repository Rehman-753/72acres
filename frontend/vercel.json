{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://project72acres.onrender.com/api/:path*" },
    { "source": "/admin", "destination": "https://project72acres.onrender.com/admin/" },
    { "source": "/admin/:path*", "destination": "https://project72acres.onrender.com/admin/:path*" },
    { "source": "/media/:path*", "destination": "https://project72acres.onrender.com/media/:path*" },
    { "source": "/static/:path*", "destination": "https://project72acres.onrender.com/static/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
